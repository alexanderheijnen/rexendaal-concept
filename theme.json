{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": { "contentSize": "720px", "wideSize": "1080px" },
    "color": {
      "defaultPalette": false,
      "palette": [
        { "slug": "ink", "name": "Inkt", "color": "#0f2e35" },
        { "slug": "petrol", "name": "Petrol", "color": "#0b4f5c" },
        { "slug": "petrol-dark", "name": "Petrol donker", "color": "#083e48" },
        { "slug": "teal", "name": "Teal", "color": "#127a8a" },
        { "slug": "soft", "name": "Zacht", "color": "#e6f1f2" },
        { "slug": "paper", "name": "Papier", "color": "#f6f8f8" },
        { "slug": "line", "name": "Lijn", "color": "#dbe4e6" },
        { "slug": "accent", "name": "Oranje (knoppen)", "color": "#e8641b" },
        { "slug": "white", "name": "Wit", "color": "#ffffff" }
      ]
    },
    "typography": {
      "fontFamilies": [
        { "slug": "serif", "name": "Fraunces", "fontFamily": "'Fraunces', Georgia, serif" },
        { "slug": "sans", "name": "Manrope", "fontFamily": "'Manrope', system-ui, -apple-system, 'Segoe UI', sans-serif" }
      ]
    },
    "spacing": { "units": ["px", "em", "rem", "%", "vw"] }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--white)", "text": "var(--wp--preset--color--ink)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--sans)", "fontSize": "17px", "lineHeight": "1.65" },
    "spacing": { "blockGap": "1.2rem", "padding": { "left": "24px", "right": "24px" } },
    "elements": {
      "heading": { "typography": { "fontFamily": "var(--wp--preset--font-family--serif)", "fontWeight": "600", "lineHeight": "1.15" } },
      "h1": { "typography": { "fontSize": "clamp(2.1rem, 4.6vw, 3.3rem)" } },
      "h2": { "typography": { "fontSize": "clamp(1.7rem, 3vw, 2.3rem)" } },
      "h3": { "typography": { "fontSize": "1.25rem" } },
      "link": { "color": { "text": "var(--wp--preset--color--teal)" } },
      "button": {
        "color": { "background": "var(--wp--preset--color--accent)", "text": "#ffffff" },
        "border": { "radius": "999px" },
        "typography": { "fontWeight": "700", "fontSize": "1rem" },
        "spacing": { "padding": { "top": "14px", "bottom": "14px", "left": "24px", "right": "24px" } },
        ":hover": { "color": { "background": "#c9520f", "text": "#ffffff" } }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
